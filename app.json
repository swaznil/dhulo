{
  "expo": {
    "name": "Dhulo",
    "slug": "dhulo",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon-v2.png",
    "scheme": "dhulo",
    "userInterfaceStyle": "automatic",
    "ios": {
      "icon": "./assets/images/icon-v2.png"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#0B1730",
        "foregroundImage": "./assets/images/brand-mark.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.swapnilxd.dhulo",
      "permissions": [
        "android.permission.MODIFY_AUDIO_SETTINGS"
      ]
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/icon-v2.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#0B1730",
          "image": "./assets/images/brand-mark.png",
          "imageWidth": 180,
          "dark": {
            "backgroundColor": "#060911",
            "image": "./assets/images/brand-mark.png"
          },
          "android": {
            "image": "./assets/images/brand-mark.png",
            "imageWidth": 180
          }
        }
      ],
      [
        "expo-audio",
        {
          "microphonePermission": false,
          "recordAudioAndroid": false
        }
      ],
      "expo-font",
      "expo-asset"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "f90bcf4b-7b48-4ef3-8830-96c8ebcce551"
      }
    },
    "owner": "swaznil"
  }
}
